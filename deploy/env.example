# Secrets and per-server values of a production site.
# Copy to .ddev/.env (not tracked) and fill in; DDEV passes these to the site.

# Every name the site answers to, comma separated. Anything else gets a 400.
SITE_HOSTS=example.com,www.example.com

# 64 or more random characters: openssl rand -hex 32
DRUPAL_HASH_SALT=

# Outgoing mail. For Gmail or Google Workspace use an app password
# (https://myaccount.google.com/apppasswords), not the account password, and
# send from the address of that account. For a relay that trusts the server's
# address (smtp-relay.gmail.com), leave SMTP_USER and SMTP_PASSWORD empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
SITE_MAIL=you@example.com

# Optional, with "ddev add-ai": the API key of the AI provider
# (https://console.anthropic.com/settings/keys).
AI_API_KEY=

# Optional: where "ddev backup" copies the backups after making them, as an
# rsync target, and how many to keep locally.
BACKUP_REMOTE=
BACKUP_KEEP=14
