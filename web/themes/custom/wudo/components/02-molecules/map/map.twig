{#
/**
 * @file
 * Map component.
 *
 * OpenStreetMap sets no cookies, so the map needs no consent. Directions
 * open in Google Maps, which most visitors navigate with.
 *
 * Variables:
 * - latitude: [number] Latitude of the place.
 * - longitude: [number] Longitude of the place.
 * - title: [string] What is on the map.
 * - address: [string] Optional address, shown under the name of the place
 *   line by line.
 * - modifier_class: [string] Additional classes.
 */
#}

{% set lat = latitude|number_format(6, '.', '') %}
{% set lon = longitude|number_format(6, '.', '') %}
{# About 600 by 300 metres around the place. #}
{% set bbox = [
  (longitude - 0.005)|number_format(6, '.', ''),
  (latitude - 0.0015)|number_format(6, '.', ''),
  (longitude + 0.005)|number_format(6, '.', ''),
  (latitude + 0.0015)|number_format(6, '.', ''),
]|join(',') %}

<div class="map {{ modifier_class|default('') }}">
  <iframe
    class="map__frame"
    src="https://www.openstreetmap.org/export/embed.html?bbox={{ bbox }}&amp;layer=mapnik&amp;marker={{ lat }},{{ lon }}"
    title="{{ 'Map: @title'|t({'@title': title}) }}"
    loading="lazy"
  ></iframe>
  {% if address %}
    <address class="map__address">
      <strong>{{ title }}</strong><br>
      {{ address|nl2br }}
    </address>
  {% endif %}
  {# Other sites, in a new tab: the label replaces the text of the link, so
     it says so too. #}
  {% set new_window = '(' ~ 'Opens in a new tab/window'|t ~ ')' %}
  <p class="map__links">
    {{ include('wudo:link', {
      text: 'Larger map'|t,
      url: 'https://www.openstreetmap.org/?mlat=' ~ lat ~ '&mlon=' ~ lon ~ '#map=17/' ~ lat ~ '/' ~ lon,
      is_external: true,
      is_new_window: true,
      attributes: create_attribute({'aria-label': 'Larger map'|t ~ ': ' ~ title ~ ' ' ~ new_window}),
    }, with_context = false) }}
    {{ include('wudo:link', {
      text: 'Directions'|t,
      url: 'https://www.google.com/maps/dir/?api=1&destination=' ~ lat ~ ',' ~ lon,
      is_external: true,
      is_new_window: true,
      attributes: create_attribute({'aria-label': 'Directions'|t ~ ': ' ~ title ~ ' ' ~ new_window}),
    }, with_context = false) }}
  </p>
</div>
