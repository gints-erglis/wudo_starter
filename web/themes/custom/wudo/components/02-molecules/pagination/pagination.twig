{#
/**
 * @file
 * Pagination component.
 *
 * Variables:
 * - heading_id: [string] Heading id.
 * - items: [array] Array of pagination items:
 *   - text: [string] Item text, unused: first, previous, next and last are
 *     icons, named by their aria-label.
 *   - href: [string] Item link.
 * - items_modifier_class: [string] Items modifier class.
 * - current: [string, integer] Current page number.
 * - attributes: [string] Additional attributes.
 * - modifier_class: [string] Additional classes.
 */
#}

{% set items_per_page_title = items_per_page_title|default('Items per page') %}
{% set modifier_class = '%s %s'|format(theme_class|default(''), modifier_class|default('')) %}

{% if items is not empty %}
  <nav
    class="pagination {{ modifier_class -}}" role="navigation"
    {% if heading_id is not empty %}aria-labelledby="{{ heading_id }}"{% endif %}
    {% if attributes is not empty %}{{- attributes|raw -}}{% endif %}
  >
    <h4 {% if heading_id is not empty %}id="{{ heading_id }}"{% endif %} class="visually-hidden">{{ 'Pagination'|t }}</h4>

    <ul class="pagination__items {{ items_modifier_class }}">
      {# Print first item if we are not on the first page. #}
      {% if items.first %}
        <li class="pagination__item pagination__item--first">
          {{ include('wudo:link', {
            text: '',
            url: items.first.href,
            icon: 'chevron-double-left',
            title: 'Go to first page'|t,
            attributes: create_attribute({'aria-label': 'Go to first page'|t}),
            modifier_class: 'pagination__link',
          }, with_context = false) }}
        </li>
      {% endif %}

      {% if items.previous %}
        <li class="pagination__item pagination__item--previous">
          {{ include('wudo:link', {
            text: '',
            url: items.previous.href,
            icon: 'chevron-left',
            title: 'Go to previous page'|t,
            attributes: create_attribute({'aria-label': 'Go to previous page'|t}),
            modifier_class: 'pagination__link',
          }, with_context = false) }}
        </li>
      {% endif %}

      {% if ellipses.previous %}
        <li class="pagination__item pagination__item--ellipsis pagination__item--ellipsis-previous" role="presentation">
          &hellip;
        </li>
      {% endif %}

      {# Generate pagination. #}
      {% for key, item in items.pages %}
        <li class="pagination__item {% if current == key %}pagination__item--active{% endif %}">
          {{ include('wudo:link', {
            text: key ~ '',
            title: current == key ? 'Current page'|t : 'Go to page @key'|t({'@key': key}),
            attributes: current == key ? create_attribute({'aria-current': 'page'}) : null,
            is_active: current == key,
            url: item.href,
            modifier_class: 'pagination__item__link',
          }, with_context = false) }}
        </li>
      {% endfor %}

      {# Add an ellipsis if there are further next pages. #}
      {% if ellipses.next %}
        <li class="pagination__item pagination__item--ellipsis pagination__item--ellipsis-next" role="presentation">
          &hellip;
        </li>
      {% endif %}

      {# Print next item if we are not on the last page. #}
      {% if items.next %}
        <li class="pagination__item pagination__item--next">
          {{ include('wudo:link', {
            text: '',
            url: items.next.href,
            icon: 'chevron-right',
            title: 'Go to next page'|t,
            attributes: create_attribute({'aria-label': 'Go to next page'|t}),
            modifier_class: 'pagination__link',
          }, with_context = false) }}
        </li>
      {% endif %}

      {# Print last item if we are not on the last page. #}
      {% if items.last %}
        <li class="pagination__item pagination__item--last">
          {{ include('wudo:link', {
            text: '',
            url: items.last.href,
            icon: 'chevron-double-right',
            title: 'Go to last page'|t,
            attributes: create_attribute({'aria-label': 'Go to last page'|t}),
            modifier_class: 'pagination__link',
          }, with_context = false) }}
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
