{
  "name": "wudo",
  "version": "1.0.0",
  "description": "Drupal 11 base theme (SDC)",
  "scripts": {
    "site": "node scripts/ensure-site.js",
    "build:sdc": "sass components:components --update --no-source-map",
    "dev:sdc": "sass components:components --watch --no-source-map",
    "dev": "npm run site && vite build --watch",
    "build": "npm run site && npm run build:sdc && vite build && npm run build:lit",
    "build:lit": "vite build --config vite.lit.config.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "lint:css": "npm run site && stylelint \"components/**/*.scss\" \"scss/**/*.scss\" \"site/**/*.scss\" \"site.example/**/*.scss\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wunderio/wudo_starter.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wunderio/wudo_starter/issues"
  },
  "homepage": "https://github.com/wunderio/wudo_starter#readme",
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/html-vite": "^10.6.1",
    "drupal-attribute": "^1.2.1",
    "sass": "^1.95.1",
    "sass-embedded": "^1.93.3",
    "storybook": "^10.6.1",
    "storybook-addon-sdc": "^0.24.21",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "twing": "^7.3.1",
    "vite": "^7.2.6"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "type": "module"
}
