{#
/**
 * @file
 * Default theme implementation for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 *
 * @ingroup themeable
 */
#}

{# Primary, unless the form marks it secondary (#button_type). #}
<button{{ attributes.addClass(attributes.hasClass('button--secondary') ? [] : ['button--primary', 'inverted']) }}>
  {{ element['#value'] }}
</button>{{ children }}
