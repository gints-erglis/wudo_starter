<?php

/**
 * @file
 * Page related functions to support theming.
 */

use Drupal\block_content\BlockContentInterface;
use Drupal\Component\Utility\Html;
use Drupal\Component\Utility\Unicode;
use Drupal\Core\Extension\ThemeSettingsProvider;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\csp\Csp;
use Drupal\link\LinkItemInterface;
use Symfony\Component\HttpFoundation\Response;

/**
 * Builds the import map that lets components import Lit by its bare name.
 *
 * Generated rather than read from a file so that it follows the theme's
 * location, e.g. when Drupal is installed in a subdirectory.
 */
function wudo_import_map(): string {
  $bundle = base_path() . \Drupal::service('extension.list.theme')->getPath('wudo') . '/dist/lit-core.bundle.js';

  return json_encode([
    'imports' => [
      'lit' => $bundle,
      'lit/directives/unsafe-html.js' => $bundle,
    ],
  ], JSON_UNESCAPED_SLASHES);
}

/**
 * Implements hook_page_attachments_alter().
 */
function wudo_page_attachments_alter(array &$attachments) {
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#attributes' => ['type' => 'importmap'],
      '#value' => wudo_import_map(),
    ],
    'wudo_importmap_inline',
  ];
}

/**
 * Implements hook_csp_policy_alter().
 *
 * Allows the inline import map by its hash, so that the Content Security
 * Policy does not need to allow inline scripts in general.
 */
function wudo_csp_policy_alter(Csp $policy, Response $response): void {
  \Drupal::service('csp.policy_helper')->appendHash(
    $policy,
    'script',
    'elem',
    [Csp::POLICY_UNSAFE_INLINE],
    Csp::calculateHash(wudo_import_map()),
  );
}

/**
 * Adds Wudo theme settings to the page template.
 */
function wudo_preprocess_page(array &$variables) {
  $variables['copyright'] = \Drupal::service(ThemeSettingsProvider::class)->getSetting('copyright', 'wudo');
  $variables['use_scroll_to_top'] = (bool) \Drupal::service(ThemeSettingsProvider::class)->getSetting('use_scroll_to_top', 'wudo');
}

/**
 * Adds custom settings to the Wudo theme settings form.
 */
function wudo_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state) {
  $form['wudo_page'] = [
    '#type' => 'details',
    '#title' => t('Page'),
    '#open' => TRUE,
  ];
  $form['wudo_page']['use_scroll_to_top'] = [
    '#type' => 'checkbox',
    '#title' => t('Use scroll to top'),
    '#default_value' => (bool) \Drupal::service(ThemeSettingsProvider::class)->getSetting('use_scroll_to_top', 'wudo'),
  ];

  $form['wudo_footer'] = [
    '#type' => 'details',
    '#title' => t('Footer'),
    '#open' => TRUE,
  ];
  $form['wudo_footer']['copyright'] = [
    '#type' => 'textfield',
    '#title' => t('Copyright text'),
    '#description' => t('Text displayed in the Footer bottom region.'),
    '#default_value' => \Drupal::service(ThemeSettingsProvider::class)->getSetting('copyright', 'wudo') ?: 'Copyright © ' . date('Y'),
    '#maxlength' => 255,
  ];
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function wudo_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    // Add content type suggestions.
    $suggestions[] = 'page__node__' . $node->bundle();
  }
}

/**
 * Implements hook_theme_suggestions_node_alter().
 */
function wudo_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  // What goes into the search index is the same for every content type:
  // the fields, without the buttons and links of the page templates.
  if (($variables['elements']['#view_mode'] ?? '') === 'search_index') {
    $suggestions[] = 'node__search_index';
  }
}

/**
 * Implements hook_preprocess_links__language_block().
 */
function wudo_preprocess_links__language_block(&$variables) {
  $language_manager = \Drupal::languageManager();
  $current_lang_id = $language_manager->getCurrentLanguage()->getId();
  $lang_items = [];

  foreach ($variables['links'] as $lang_code => $item) {
    if (isset($item['link']['#url'])) {
      /** @var \Drupal\Core\Url $url */
      $url = $item['link']['#url'];

      $url->setOption('language', $language_manager->getLanguage($lang_code));
      $url_string = $url->toString();

      $lang_items[] = [
        'code'       => $lang_code,
        'text'       => $item['text'],
        'url'        => $url_string,
        'is_active'  => ($lang_code === $current_lang_id),
        'attributes' => $item['attributes'],
      ];
    }
  }

  $variables['custom_languages'] = $lang_items;
}

/**
 * Implements hook_preprocess_HOOK() for the social links menu.
 *
 * Picks the icon of each link from its address, so that editors only have to
 * paste the URL of the profile.
 */
function wudo_preprocess_menu__social(array &$variables): void {
  $icons = [
    'bsky.app' => 'bluesky',
    'facebook.com' => 'facebook',
    'fb.com' => 'facebook',
    'github.com' => 'github',
    'instagram.com' => 'instagram',
    'linkedin.com' => 'linkedin',
    'pinterest.com' => 'pinterest',
    't.me' => 'telegram',
    'telegram.org' => 'telegram',
    'threads.com' => 'threads',
    'threads.net' => 'threads',
    'tiktok.com' => 'tiktok',
    'twitter.com' => 'twitter-x',
    'x.com' => 'twitter-x',
    'wa.me' => 'whatsapp',
    'whatsapp.com' => 'whatsapp',
    'youtu.be' => 'youtube',
    'youtube.com' => 'youtube',
  ];

  foreach ($variables['items'] as &$item) {
    /** @var \Drupal\Core\Url $url */
    $url = $item['url'];
    $uri = $url->isExternal() ? $url->getUri() : $url->toString();
    $host = strtolower((string) parse_url($uri, PHP_URL_HOST));

    $item['icon'] = 'globe';
    if (str_starts_with($uri, 'mailto:')) {
      $item['icon'] = 'envelope';
    }
    elseif (preg_match('/(rss|feed)(\.xml)?$/', (string) parse_url($uri, PHP_URL_PATH))) {
      $item['icon'] = 'rss';
    }
    elseif (str_contains($host, 'mastodon')) {
      $item['icon'] = 'mastodon';
    }
    else {
      foreach ($icons as $domain => $icon) {
        if ($host === $domain || str_ends_with($host, '.' . $domain)) {
          $item['icon'] = $icon;
          break;
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for blocks.
 *
 * Gives a banner the address of its link.
 */
function wudo_preprocess_block(array &$variables): void {
  $block = $variables['content']['#block_content'] ?? NULL;
  if (!$block instanceof BlockContentInterface || $block->bundle() !== 'banner') {
    return;
  }
  $link = $block->get('field_banner_link')->first();
  if ($link instanceof LinkItemInterface) {
    $url = $link->getUrl();
    $variables['banner_url'] = $url->toString();
    $variables['banner_external'] = $url->isExternal();
  }
}

/**
 * Implements hook_preprocess_HOOK() for nested checkboxes of exposed filters.
 *
 * A checked option keeps the options above it checked: Facets leaves the
 * parent out of the query when a child is chosen, and unchecks it, but the
 * child shows under a checked parent only (filter-bar.scss).
 */
function wudo_preprocess_bef_checkboxes(array &$variables): void {
  if (empty($variables['is_nested'])) {
    return;
  }
  $element = &$variables['element'];
  $trail = [];
  foreach ($variables['children'] as $child) {
    $depth = (int) ($variables['depth'][$child] ?? 0);
    $trail = array_slice($trail, 0, $depth);
    if (!empty($element[$child]['#checked'])) {
      foreach ($trail as $parent) {
        $element[$parent]['#checked'] = TRUE;
      }
    }
    $trail[] = $child;
  }
}

/**
 * Implements hook_preprocess_HOOK() for nodes.
 *
 * Gives cards the start of the body for when there is no description, and
 * prepares the facts list of a project: every field shown in "Manage
 * display", apart from the ones the template places itself, becomes a row
 * labelled with the name of the field.
 */
function wudo_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];

  // A card shows the description; one without it shows the start of the
  // paragraphs of the body, as plain text, without headings or lists.
  if ($variables['view_mode'] === 'teaser' && $node->hasField('field_body') && !$node->get('field_body')->isEmpty()) {
    $paragraphs = [];
    foreach (Html::load((string) $node->get('field_body')->value)->getElementsByTagName('p') as $paragraph) {
      $paragraphs[] = $paragraph->textContent;
    }
    $text = trim(preg_replace('/\s+/u', ' ', implode(' ', $paragraphs)));
    $variables['summary_fallback'] = Unicode::truncate($text, 200, TRUE, TRUE);
  }

  if ($node->bundle() !== 'project') {
    return;
  }

  // Projects that span several years show a range, e.g. "2025–2026".
  $years = [];
  foreach (['field_project_year', 'field_project_year_end'] as $field) {
    if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
      $years[] = $node->get($field)->value;
    }
  }
  $variables['project_years'] = implode('–', array_unique($years));

  $placed = [
    'field_body',
    'field_description',
    'field_image',
    'field_images',
    'field_project_year_end',
  ];
  $facts = [];
  foreach (Element::children($variables['content'], TRUE) as $name) {
    $element = $variables['content'][$name];
    if (($element['#theme'] ?? NULL) !== 'field' || in_array($name, $placed, TRUE)) {
      continue;
    }
    $facts[$name] = [
      'label' => $element['#title'],
      'value' => ['#label_display' => 'hidden'] + $element,
    ];
  }
  if (isset($facts['field_project_year'])) {
    $facts['field_project_year']['value'] = ['#plain_text' => $variables['project_years']];
  }
  $variables['facts'] = $facts;
}
